# URL del proyecto Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública "anon"/"publishable" del proyecto (Project Settings → API)
# No es secreta: se usa en el cliente, protegida por RLS en la base de datos.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=tu-clave-publica
